{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/update_project_map.py"
          },
          {
            "type": "command",
            "command": "python3 scripts/emit_kernel.py"
          }
        ]
      }
    ]
  }
}
