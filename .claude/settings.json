{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/update_project_map.py"
          },
          {
            "type": "command",
            "command": "python3 scripts/emit_kernel.py"
          },
          {
            "type": "command",
            "command": "python3 scripts/resume_check.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/checkpoint_session.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/checkpoint_session.py"
          },
          {
            "type": "command",
            "command": "python3 scripts/push_repo.py"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/clear_checkpoint.py"
          }
        ]
      }
    ]
  }
}
